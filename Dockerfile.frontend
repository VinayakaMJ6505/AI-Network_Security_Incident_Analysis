# ============================================================
# Frontend Dockerfile — React/Vite → Nginx (Cloud Run)
# Multi-stage: Node build then serve with nginx:alpine
# ============================================================
# ── Stage 1: Node build ──────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
# devDependencies are required here: vite (and the rest of the build
# toolchain) live there, not in dependencies. Only the built dist/ output
# gets copied into the runtime stage below, so nothing extra ships.
RUN npm ci

COPY frontend/ ./
# Inject the backend API URL at build time via build arg
# (overridden by docker-compose / Cloud Build substitution)
ARG VITE_API_BASE_URL=https://api.your-project.run.app
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build


# ── Stage 2: nginx serve ─────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Remove default nginx page
RUN rm -rf /usr/share/nginx/html/*

# Copy Vite production build
COPY --from=builder /app/dist /usr/share/nginx/html

# nginx config — handles React router & /api proxy to backend
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
