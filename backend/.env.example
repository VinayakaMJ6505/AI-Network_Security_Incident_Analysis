# ============================================================
# Backend .env.example — copy to .env and fill in values
# Never commit the actual .env file.
# ============================================================

# Server (overridden by Cloud Run environment automatically)
HOST=0.0.0.0
PORT=8080

# MongoDB — db_service.py speaks MongoDB via pymongo, so any of these work
# with zero code changes:
#
# Local dev:
MONGODB_URI=mongodb://localhost:27017
#
# GCP-native, no separate account needed — Firestore with MongoDB
# compatibility (this project's DB: "incident-db" in smart-resume-analyzer-a7x2,
# us-central1). Two ways to authenticate:
#
#   1. Keyless, for the deployed Cloud Run backend (recommended) — uses the
#      Cloud Run service account's ambient credentials, no password stored
#      anywhere. Requires the service account to hold "roles/datastore.user"
#      (one-time: `gcloud projects add-iam-policy-binding <project> \
#        --member=serviceAccount:<cloud-run-runtime-sa> --role=roles/datastore.user`):
# MONGODB_URI=mongodb://2594eb81-81cd-4c5f-aaab-88bfced4c2c5.us-central1.firestore.goog:443/incident-db?loadBalanced=true&tls=true&retryWrites=false&authMechanism=MONGODB-OIDC&authMechanismProperties=ENVIRONMENT:gcp,TOKEN_RESOURCE:FIRESTORE
#
#   2. Username/password (SCRAM), for connecting from OUTSIDE GCP (e.g. this
#      repo's own dev machine, or seeding scripts run locally) — the OIDC
#      method above only works from within a GCP compute environment
#      (Cloud Run/GCE), since it reads the instance metadata server.
#      Create credentials with:
#        `gcloud firestore user-creds create <name> --database=incident-db`
# MONGODB_URI=mongodb://<user>:<password>@2594eb81-81cd-4c5f-aaab-88bfced4c2c5.us-central1.firestore.goog:443/incident-db?loadBalanced=true&authMechanism=SCRAM-SHA-256&tls=true&retryWrites=false
#
# Alternative — MongoDB Atlas (external account, if preferred over Firestore):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
#
# NOTE: with the Firestore options above, MONGODB_DB_NAME below must be
# "incident-db" (hyphen) to match the Firestore database ID in the URI path —
# Firestore compatibility mode doesn't support multiple logical databases per
# connection the way a real MongoDB server does. For local/Atlas, the
# underscored "incident_db" below (matching docker-compose.yml and the seed
# scripts) is correct and unrelated to that constraint.
MONGODB_DB_NAME=incident_db

# CORS — comma-separated list of allowed frontend origins
# Leave as * for local dev; set to your Cloud Run frontend URL in production
ALLOWED_ORIGINS=*
# ALLOWED_ORIGINS=https://ai-security-frontend-xyz-uc.a.run.app

# Optional GenAI Keys (falls back to local knowledge engine if not set)
GROQ_API_KEY=
OPENAI_API_KEY=

# GCP Project — also used by services/genai_service.py: when GCP_PROJECT_ID
# is set, GenAI explanations are generated via Vertex AI (Gemini) using
# Application Default Credentials (no API key needed), checked BEFORE
# GROQ_API_KEY/OPENAI_API_KEY above. Requires the Cloud Run runtime service
# account to hold the "Vertex AI User" role — deploy-gcp.sh grants this
# automatically; the GitHub Actions / Cloud Build paths require it be
# granted once manually (see comments in those files).
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
