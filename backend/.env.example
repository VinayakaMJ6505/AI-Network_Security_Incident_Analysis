# ============================================================
# Backend .env.example — copy to .env and fill in values
# Never commit the actual .env file.
# ============================================================

# Server (overridden by Cloud Run environment automatically)
HOST=0.0.0.0
PORT=8080

# MongoDB
# Local dev:
MONGODB_URI=mongodb://localhost:27017
# GCP (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=incident_db

# CORS — comma-separated list of allowed frontend origins
# Leave as * for local dev; set to your Cloud Run frontend URL in production
ALLOWED_ORIGINS=*
# ALLOWED_ORIGINS=https://ai-security-frontend-xyz-uc.a.run.app

# Optional GenAI Keys (falls back to local knowledge engine if not set)
GROQ_API_KEY=
OPENAI_API_KEY=

# GCP Project (used by gcloud CLI / SDK)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
