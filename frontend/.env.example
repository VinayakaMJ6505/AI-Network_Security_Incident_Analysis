# Frontend environment variables
# In development these are auto-injected by Vite.
# In production (Docker build for GCP) VITE_API_BASE_URL is passed as a build arg.

# Leave empty in development — Vite proxy handles /api -> localhost:8000
VITE_API_BASE_URL=

# In production (GCP Cloud Run) — set this to the Cloud Run backend service URL, e.g.:
# VITE_API_BASE_URL=https://ai-security-backend-abc123-uc.a.run.app
